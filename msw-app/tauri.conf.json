{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModernMonitorSwitcher",
  "version": "1.3.0",
  "identifier": "com.jacobpoteet.modernmonitorswitcher",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Modern Monitor Switcher",
        "width": 1040,
        "height": 730,
        "minWidth": 600,
        "minHeight": 460,
        "resizable": true,
        "center": true,
        "visible": false,
        "skipTaskbar": false,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Jacob Poteet",
    "copyright": "Copyright (c) Jacob Poteet. Licensed under the MPL 2.0.",
    "category": "Utility",
    "shortDescription": "Switch between saved monitor configurations",
    "longDescription": "Save your monitor arrangements as named profiles and switch between them from the system tray, a hotkey, or the command line.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/msw"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBRkI2NTVGOEJBOTFCMjMKUldRakc2bUxYMlg3cWwweTVCUGYzRzNqWTlCWDJiVEEzSGdneHRTVU9UbW0zZzN2UjdKMWVmWkYK",
      "endpoints": [
        "https://github.com/JacobPoteet/ModernMonitorSwitcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
